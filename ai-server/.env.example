# 실제 값은 set-key.ps1 (또는 python scripts/set_key.py)로 등록하세요.
# 이 파일을 복사해 쓰지 마세요. .env는 .gitignore에 있어 저장소에 올라가지 않습니다.

# LLM API 키 — 현재 코드는 Anthropic 전용입니다 (app/llm/client.py).
# 공급자를 바꾸려면 코드 교체가 함께 필요합니다. 키만 바꿔서는 동작하지 않습니다.
ANTHROPIC_API_KEY=

# 백엔드와 공유하는 내부 API 토큰 — 백엔드가 생성해 팀 채널로 전달합니다.
# 양쪽 값이 정확히 같아야 합니다. 직접 만들면 인증이 전부 401로 막힙니다.
INTERNAL_TOKEN=
