{
  // 해빙 AI-server — Cloudflare Containers 배포 설정.
  // 절차: docs/deployment.md
  "name": "haebing-ai-server",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-25",

  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "AiServer",
      // 이 파일과 같은 폴더의 Dockerfile을 그대로 빌드한다 (구현은 바뀌지 않는다).
      "image": "./Dockerfile",
      // 무상태 서버이고 Worker가 항상 같은 인스턴스로 보내므로 1개면 된다.
      // 동시 요청 제한은 컨테이너 안 FastAPI의 MAX_CONCURRENCY가 담당한다.
      "max_instances": 1,
      // lite(256MiB)는 10MB 이미지 × 동시 4건(base64 포함 약 13MB씩)에 빠듯하다.
      "instance_type": "basic"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "AI_SERVER", "class_name": "AiServer" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AiServer"] }]
}
