# 이 파일을 복사해 .env로 저장한 뒤 값을 채우세요.
# .env는 git에 올라가지 않습니다. 실제 비밀값을 이 파일(.env.example)에 넣지 마세요.

# ── DB (Phase 1) ────────────────────────────────────────────────────────────
# 로컬: docker-compose.yml의 db 서비스 기본값과 동일합니다.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/haebing
SPRING_DATASOURCE_USERNAME=haebing
SPRING_DATASOURCE_PASSWORD=haebing

# ── CORS (Phase 1) ──────────────────────────────────────────────────────────
# Vite 개발 서버 기본값 (2026-08-24 확정)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── AI-server 내부 인증 (Phase 3) ───────────────────────────────────────────
# 32자 이상 랜덤. 값은 팀 채널로만 공유 — 이 파일이나 저장소에 실제 값을 넣지 않는다.
INTERNAL_TOKEN=

# ── AI-server 연동 (Phase 3) ─────────────────────────────────────────────────
# AI_SERVER_URL=
